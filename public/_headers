# Response headers for Workers static assets (copied to dist/ by the build).
# Files under /_astro/ have content hashes in their names, so they never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
# Wrangler sends text/plain without a charset for .txt files, and browsers then read
# the Japanese text of llms.txt (src/pages/llms.txt.ts) in another encoding.
/llms.txt
  Content-Type: text/plain; charset=utf-8

{
  "name": "justitia",
  "version": "1.0.0",
  "description": "Japanese laws and their amendment history as a website, built from the houritsu git repository",
  "scripts": {
    "fetch-houritsu": "git clone --no-single-branch https://github.com/Kohei-Wada/houritsu.git houritsu || git -C houritsu fetch --prune origin && git -C houritsu checkout -q --detach origin/main",
    "extract": "node scripts/extract/index.ts --repo houritsu --out data",
    "typecheck": "tsc -p .",
    "test": "node --test 'scripts/**/*.test.ts' 'src/**/*.test.ts'",
    "dev": "astro dev",
    "build": "astro build",
    "search-index": "node scripts/search-index.ts",
    "preview": "node scripts/preview.ts",
    "upload-data": "scripts/upload-data.sh",
    "deploy": "npx --yes wrangler@4.151.3 deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xCAFEBABEx0/justitia.git"
  },
  "bugs": {
    "url": "https://github.com/0xCAFEBABEx0/justitia/issues"
  },
  "homepage": "https://github.com/0xCAFEBABEx0/justitia#readme",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "astro": "^7.4.7",
    "diff": "^9.0.0",
    "diff-match-patch": "^1.0.5",
    "marked": "^18.1.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^26.6.6",
    "daisyui": "^5.7.50",
    "pagefind": "^1.6.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  }
}

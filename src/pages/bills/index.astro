---
// 「国会で審議中の法律案」: the law bills pending in the Diet (src/lib/bills.ts), those one house has
// passed first, each with its steps and the laws it would amend when its title names them. Law pages
// show the same bills in their history.
import Base from "../../layouts/Base.astro";
import BillSteps from "../../components/BillSteps.astro";
import PageHeader from "../../components/PageHeader.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import {
  billHeadline,
  billName,
  billsFile,
  billStage,
  billSteps,
  BILLS_LICENSE_URL,
  BILLS_SOURCE_CREDIT,
  BILLS_SOURCE_NAME,
  BILLS_SOURCE_URL,
  lawsAmendedBy,
  type BillKind,
  type BillStage,
  type House,
  type PendingBill,
} from "../../lib/bills.ts";
import { jpDate, lawUrl } from "../../lib/data.ts";

const file = billsFile();
const bills = file?.bills ?? [];
const KIND_ORDER: Record<BillKind, number> = { 閣法: 0, 衆法: 1, 参法: 2 };
const latest = (b: PendingBill) => billHeadline(b).date ?? "";
const SECTIONS: { stage: BillStage; house: House; title: string }[] = [
  { stage: "passed", house: "衆議院", title: "衆議院を通過した法律案" },
  { stage: "passed", house: "参議院", title: "参議院を通過した法律案" },
  { stage: "first", house: "衆議院", title: "衆議院で審議中の法律案" },
  { stage: "first", house: "参議院", title: "参議院で審議中の法律案" },
];
const sections = SECTIONS.map((s) => ({
  ...s,
  items: bills
    .filter((b) => {
      const at = billStage(b);
      return at.stage === s.stage && at.house === s.house;
    })
    .sort((a, b) => latest(b).localeCompare(latest(a)) || KIND_ORDER[a.kind] - KIND_ORDER[b.kind] || a.number - b.number),
})).filter((s) => s.items.length > 0);
const counts = (["閣法", "衆法", "参法"] as const).map((k) => [k, bills.filter((b) => b.kind === k).length] as const).filter(([, n]) => n > 0);
---
<Base
  title="国会で審議中の法律案"
  description="国会で審議中の法律案（閣法・衆法・参法）の一覧です。審議の進み具合と、法律案が改正する法令を、衆議院の議案データベースから毎日更新しています。"
  nav="bills"
>
  <PageHeader title="国会で審議中の法律案">
    国会で審議中の法律案を、審議が進んでいる順に並べています（{bills.length.toLocaleString()} 件）。題名から改正する法令が分かるものは、その法令へのリンクを付けています。{file && `${jpDate(file.updated)}時点。`}
  </PageHeader>

  <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_340px]">
    <div class="flex flex-col gap-8">
      {!file && <p class="text-sm">法律案のデータを取得できませんでした。</p>}
      {file && bills.length === 0 && <p class="text-sm">いま国会で審議中の法律案はありません。</p>}
      {sections.map((s) => (
        <section>
          <h2 class="mb-3 text-xl font-bold">{s.title}（{s.items.length} 件）</h2>
          <ul class="grid gap-4 md:grid-cols-2">
            {s.items.map((b) => {
              const head = billHeadline(b);
              const amended = lawsAmendedBy(b);
              return (
                <li class="card card-border bg-base-100">
                  <div class="card-body gap-1 p-4 text-sm">
                    <div class="text-xs font-bold text-base-content/70">
                      {head.date ? `${jpDate(head.date)} ` : ""}{head.text}
                      <StatusBadge kind="pending" label="審議中" />
                    </div>
                    <h3 class="text-base font-bold">
                      {b.honbunUrl ? <a class="link link-hover text-primary" href={b.honbunUrl} rel="noopener">{b.title}</a> : b.title}
                    </h3>
                    <div class="text-xs text-base-content/65">{billName(b)}{b.kind !== "閣法" && b.submitter ? `、提出：${b.submitter}` : ""}</div>
                    {amended.length > 0 && (
                      <div class="mt-1">
                        改正する法令：{amended.map((l, i) => <>{i > 0 && "、"}<a class="link" href={lawUrl(l.id)}>{l.title}</a></>)}
                      </div>
                    )}
                    <BillSteps steps={billSteps(b)} year={head.date?.slice(0, 4)} />
                    {b.keikaUrl && (
                      <div class="text-xs"><a class="link link-hover link-primary inline-block py-1" href={b.keikaUrl} rel="noopener">審議経過（衆議院）</a></div>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
    <aside class="flex flex-col gap-4 lg:sticky lg:top-[4.5rem] lg:order-last">
      <section class="card card-border bg-base-100">
        <div class="card-body gap-2 p-5 text-sm">
          <h2 class="card-title text-base">この一覧について</h2>
          {counts.length > 0 && <p>{counts.map(([k, n]) => `${k} ${n} 件`).join("、")}（閣法は内閣、衆法・参法は衆議院・参議院の議員が提出した法律案です）。</p>}
          <p class="text-base-content/70">成立前の法律案です。修正されたり、成立しなかったりすることがあります。成立して公布された改正は<a class="link" href="/upcoming/">施行予定の改正</a>に載ります。</p>
          <p class="text-base-content/70">改正する法令は法律案の題名から調べています。新しい法律の法律案や、題名に法令名がない法律案（整備法など）にはリンクがありません。</p>
          <p class="text-xs text-base-content/65">出典：<a class="link" href={BILLS_SOURCE_URL} rel="noopener">{BILLS_SOURCE_NAME}</a>（{BILLS_SOURCE_CREDIT}、<a class="link" href={BILLS_LICENSE_URL} rel="noopener">MIT ライセンス</a>）</p>
        </div>
      </section>
    </aside>
  </div>
</Base>

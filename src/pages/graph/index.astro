---
import Base from "../../layouts/Base.astro";
import { buildDate, dataVersion } from "../../lib/data.ts";
import PageHeader from "../../components/PageHeader.astro";
import { DATA_BASE } from "../../lib/site.ts";

const today = buildDate();
---
<Base
  title="改正のグラフ"
  description="法令ごとの改正を Git のブランチのような図で並べます。同じ改正法令で一緒に変わった法令は線でつながります。"
  nav="graph"
>
  <PageHeader title="改正のグラフ">
    法令ごとに1本の枝を立て、施行日の新しい順に改正を並べています。同じ改正法令で一緒に変わった法令は横線でつながります。
    点を押すと、その改正の新旧対照を開きます。
  </PageHeader>
  <div id="graph" data-base={DATA_BASE} data-v={dataVersion()} data-today={today}>
    <div class="mb-2 flex flex-wrap items-center gap-x-4 gap-y-2">
      <div class="flex min-w-0 flex-1 flex-wrap gap-1.5" data-lanes></div>
      <div class="relative w-full sm:w-64" data-graph-search>
        <input class="input input-sm w-full" type="search" placeholder="法令を追加" aria-label="グラフに法令を追加" autocomplete="off" />
      </div>
    </div>
    <div class="mb-4 flex flex-wrap items-center gap-1.5 text-sm" data-suggest></div>
    <div data-body><p class="flex items-center gap-2 py-10 text-base-content/60"><span class="loading loading-spinner loading-sm"></span>読み込み中…</p></div>
  </div>
  <noscript>グラフを表示するには JavaScript を有効にしてください。</noscript>
  <script>
    import { initGraph } from "../../scripts/graph.ts";
    initGraph(document.getElementById("graph")!);
  </script>
</Base>

---
import Base from "../../layouts/Base.astro";
import { buildDate, dataVersion } from "../../lib/data.ts";
import { DATA_BASE } from "../../lib/site.ts";

const today = buildDate();
---
<Base title="改正のグラフ" nav="graph">
  <h1 class="page-title">改正のグラフ</h1>
  <p class="subtitle">
    法令ごとに1本の枝を立て、施行日の新しい順に改正を並べています。同じ改正法令で一緒に変わった法令は横線でつながります。
    点を押すと、その改正の新旧対照を開きます。
  </p>
  <div id="graph" data-base={DATA_BASE} data-v={dataVersion()} data-today={today}>
    <div class="graph-controls">
      <div class="graph-lanes" data-lanes></div>
      <div class="search graph-add" data-graph-search>
        <input type="search" placeholder="法令を追加" aria-label="グラフに法令を追加" autocomplete="off" />
      </div>
    </div>
    <div class="graph-suggest" data-suggest></div>
    <div data-body><p class="loading">読み込み中…</p></div>
  </div>
  <noscript>グラフを表示するには JavaScript を有効にしてください。</noscript>
  <script>
    import { initGraph } from "../../scripts/graph.ts";
    initGraph(document.getElementById("graph")!);
  </script>
</Base>

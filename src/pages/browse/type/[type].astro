---
import Base from "../../../layouts/Base.astro";
import BrowseTabs from "../../../components/BrowseTabs.astro";
import LawList from "../../../components/LawList.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { laws, TYPE_ORDER, typeLabel } from "../../../lib/data.ts";

export function getStaticPaths() {
  return TYPE_ORDER.map((type) => ({ params: { type } }));
}
const { type } = Astro.params;
const all = laws().filter((l) => l.dir === type);
const current = all.filter((l) => l.status !== "repealed");
const repealed = all.filter((l) => l.status === "repealed");
---
<Base
  title={`${typeLabel(type)}の一覧`}
  description={`現行の${typeLabel(type)} ${current.length.toLocaleString()} 件の一覧。条文と改正の履歴へ移動できます。`}
  nav="laws"
>
  <PageHeader title={typeLabel(type)} crumbs={[{ href: "/browse/", label: "法令一覧" }]}>
    {current.length.toLocaleString()} 件{repealed.length > 0 && `（ほかに廃止 ${repealed.length} 件）`}
  </PageHeader>
  <BrowseTabs mode="type" current={type} />
  <LawList laws={current} showType={false} />
  {repealed.length > 0 && (
    <details class="collapse-arrow collapse mt-6 border border-base-300 bg-base-100">
      <summary class="collapse-title font-bold">廃止された{typeLabel(type)}（{repealed.length} 件）</summary>
      <div class="collapse-content">
        <p class="mb-2 text-sm"><a class="link link-primary" href="/repealed/">廃止日や廃止した法令は「廃止された法令」の一覧で見られます →</a></p>
        <LawList laws={repealed} showType={false} />
      </div>
    </details>
  )}
</Base>

---
import Base from "../../../layouts/Base.astro";
import BrowseTabs from "../../../components/BrowseTabs.astro";
import LawList from "../../../components/LawList.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { laws, TYPE_ORDER } from "../../../lib/data.ts";
import { feedFile, feedUrl } from "../../../lib/feeds.ts";
import { DATA_BASE, SITE_NAME } from "../../../lib/site.ts";

export function getStaticPaths() {
  const cats = new Set(laws().map((l) => l.category).filter((c): c is string => !!c));
  return [...cats].map((category) => ({ params: { category } }));
}
const { category } = Astro.params;
const list = laws()
  .filter((l) => l.category === category && l.status !== "repealed")
  .sort((a, b) => TYPE_ORDER.indexOf(a.dir) - TYPE_ORDER.indexOf(b.dir));
---
<Base
  title={`${category}の法令`}
  description={`分野「${category}」の現行の法令 ${list.length.toLocaleString()} 件の一覧。条文と改正の履歴へ移動できます。`}
  nav="laws"
  feed={{ title: `${category}の法令の改正（${SITE_NAME}）`, href: feedUrl(DATA_BASE, feedFile.category(category, "xml")) }}
>
  <PageHeader title={category} crumbs={[{ href: "/browse/", label: "法令一覧" }, { href: "/browse/#category", label: "分野" }]}>
    {list.length.toLocaleString()} 件（種別順・五十音順）
  </PageHeader>
  <BrowseTabs mode="category" current={category} />
  <LawList laws={list} />
</Base>

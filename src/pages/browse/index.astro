---
import Base from "../../layouts/Base.astro";
import BrowseTabs from "../../components/BrowseTabs.astro";
import PageHeader from "../../components/PageHeader.astro";
import { laws, TYPE_LABELS, TYPE_ORDER } from "../../lib/data.ts";

const all = laws();
const inForce = all.filter((l) => l.status === "in_force");
const byType = TYPE_ORDER.map((t) => ({ t, n: inForce.filter((l) => l.dir === t).length }));
const categories = new Map<string, number>();
for (const l of inForce) if (l.category) categories.set(l.category, (categories.get(l.category) ?? 0) + 1);
const cats = [...categories].sort((a, b) => a[0].localeCompare(b[0], "ja"));
---
<Base
  title="法令一覧"
  description={`現行の法令 ${inForce.length.toLocaleString()} 件を、五十音・種別（法律・政令・府省令など）・分野から探せます。`}
  nav="laws"
>
  <PageHeader title="法令一覧">現行 {inForce.length.toLocaleString()} 件、廃止 {all.filter((l) => l.status === "repealed").length.toLocaleString()} 件。五十音・種別・分野から探せます。</PageHeader>
  <BrowseTabs mode="none" />

  <h2 class="mt-8 mb-3 text-xl font-bold">種別</h2>
  <div class="grid grid-cols-[repeat(auto-fill,minmax(14rem,1fr))] gap-3">
    {byType.map(({ t, n }) => (
      <a class="card card-border card-sm bg-base-100 transition-colors hover:border-primary" href={`/browse/type/${t}/`}>
        <div class="card-body"><b class="text-base">{TYPE_LABELS[t]}</b><div class="text-xs text-base-content/60">{n.toLocaleString()} 件</div></div>
      </a>
    ))}
  </div>

  <h2 id="category" class="mt-8 mb-3 text-xl font-bold">分野</h2>
  <div class="grid grid-cols-[repeat(auto-fill,minmax(14rem,1fr))] gap-3">
    {cats.map(([c, n]) => (
      <a class="card card-border card-sm bg-base-100 transition-colors hover:border-primary" href={`/browse/category/${c}/`}>
        <div class="card-body"><b class="text-base">{c}</b><div class="text-xs text-base-content/60">{n.toLocaleString()} 件</div></div>
      </a>
    ))}
  </div>
</Base>

---
import Base from "../layouts/Base.astro";
import AmendmentList from "../components/AmendmentList.astro";
import NewLawList from "../components/NewLawList.astro";
import BrowseTabs from "../components/BrowseTabs.astro";
import { buildDate, jpDate, jstDate, lawUrl, meta, newLaws, repealedLaws, timeline, timelineYears, typeLabel, type AmendmentSummary } from "../lib/data.ts";
import { isUpcomingNewLaw } from "../lib/new-laws.ts";
import { SITE_TAGLINE } from "../lib/site.ts";

const m = meta();
const today = buildDate();
const thisYear = Number(today.slice(0, 4));
// The latest enforced amendments come from this year and last year; the next upcoming ones
// from this year and the next two.
const pool = (from: number, to: number): AmendmentSummary[] =>
  timelineYears()
    .filter((y) => y !== "undetermined" && Number(y) >= from && Number(y) <= to)
    .flatMap((y) => timeline(y));
const recent = pool(thisYear - 1, thisYear)
  .filter((a) => a.branch === "main" && a.enforced && a.enforced <= today)
  .sort((a, b) => b.enforced!.localeCompare(a.enforced!))
  .slice(0, 15);
const upcoming = pool(thisYear, thisYear + 2)
  .filter((a) => a.branch === "upcoming" && a.enforced && a.enforced > today)
  .sort((a, b) => a.enforced!.localeCompare(b.enforced!))
  .slice(0, 10);
// Newly enacted laws: the latest in force, and the next ones to come into force.
const allNew = newLaws();
const recentNew = allNew.filter((l) => l.branch === "main" && l.enforced && l.enforced <= today).slice(0, 6);
const upcomingNew = allNew
  .filter((l) => isUpcomingNewLaw(l, today) && l.enforced)
  .sort((a, b) => a.enforced!.localeCompare(b.enforced!))
  .slice(0, 5);
const recentRepealed = repealedLaws().filter((l) => l.enforced && l.enforced <= today).slice(0, 5);
const newThisYear = allNew.filter((l) => l.branch === "main" && l.enforced?.startsWith(today.slice(0, 4)) && l.enforced <= today).length;
---
<Base
  description={`日本の法令 ${m.counts.lawsInForce.toLocaleString()} 件の条文と、${m.counts.amendments.toLocaleString()} 件の改正を新旧対照で。いつ・どこが・どう変わったかを、改正ごとの差分・年表・グラフで見られます。`}
>
  <section class="mt-2 mb-8">
    <h1 class="text-3xl leading-snug font-bold sm:text-4xl">{SITE_TAGLINE}</h1>
    <p class="mt-2 max-w-[46em] text-base-content/70">
      日本の法令 {m.counts.lawsInForce.toLocaleString()} 件の条文と、{m.counts.amendments.toLocaleString()} 件の改正を、「いつ・どこが・どう変わったか」が分かる新旧対照の形で見られます。
    </p>
    <div class="relative mt-5 max-w-xl" data-search>
      <label class="input input-lg w-full">
        <svg class="h-5 w-5 opacity-50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input type="search" placeholder="法令名・略称・法令番号で検索（例：民法、個人情報保護法）" aria-label="法令を検索" autocomplete="off" />
      </label>
    </div>
  </section>

  <BrowseTabs mode="none" />

  <div class="mt-6 grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_340px]">
    <div class="flex flex-col gap-8">
      <section>
        <h2 class="mb-3 text-xl font-bold">新しく施行された法令</h2>
        <NewLawList items={recentNew} groupByDate={false} />
        <p class="mt-4"><a class="link link-primary" href="/new/">新しく制定された法令をすべて見る →</a></p>
      </section>
      <section>
        <h2 class="mb-3 text-xl font-bold">最近施行された改正</h2>
        <AmendmentList items={recent} />
        <p class="mt-4"><a class="link link-primary" href={`/timeline/${today.slice(0, 4)}/`}>{today.slice(0, 4)}年の改正をすべて見る →</a></p>
      </section>
    </div>
    <aside class="flex flex-col gap-4">
      {upcomingNew.length > 0 && (
        <section class="card card-border bg-base-100">
          <div class="card-body p-5">
            <h2 class="card-title text-base">これから施行される新しい法令</h2>
            <NewLawList items={upcomingNew} groupByDate={false} bare />
            <p class="text-xs text-base-content/65"><a class="link" href="/new/">公布済みで施行前の新しい法令をすべて見る</a></p>
          </div>
        </section>
      )}
      <section class="card card-border bg-base-100">
        <div class="card-body p-5">
          <h2 class="card-title text-base">これから施行される改正</h2>
          <AmendmentList items={upcoming} groupByDate={false} bare />
          <p class="text-xs text-base-content/65">公布済みで施行前の改正です（{m.counts.upcomingAmendments.toLocaleString()} 件）。</p>
        </div>
      </section>
      {recentRepealed.length > 0 && (
        <section class="card card-border bg-base-100">
          <div class="card-body p-5">
            <h2 class="card-title text-base">最近廃止された法令</h2>
            <ul class="list">
              {recentRepealed.map((l) => (
                <li class="list-row px-0 py-2.5">
                  <div class="list-col-grow">
                    <div class="text-xs font-bold text-base-content/70">{jpDate(l.enforced)} 廃止</div>
                    <a class="link link-hover font-bold text-primary" href={lawUrl(l.id)}>{l.title}</a>
                    <div class="mt-1 text-xs text-base-content/65">{typeLabel(l.dir)}{l.newLaw && "・新しい法令の施行に伴う廃止"}</div>
                  </div>
                </li>
              ))}
            </ul>
            <p class="text-xs text-base-content/65"><a class="link" href="/repealed/">廃止された法令をすべて見る</a></p>
          </div>
        </section>
      )}
      <section class="card card-border bg-base-100">
        <div class="stats stats-vertical">
          <div class="stat py-3"><div class="stat-title text-base-content/65">現行の法令</div><div class="stat-value text-2xl">{m.counts.lawsInForce.toLocaleString()}</div></div>
          <div class="stat py-3"><div class="stat-title text-base-content/65">廃止された法令</div><div class="stat-value text-2xl"><a class="link link-hover" href="/repealed/">{m.counts.lawsRepealed.toLocaleString()}</a></div></div>
          <div class="stat py-3"><div class="stat-title text-base-content/65">{today.slice(0, 4)}年に施行された新しい法令</div><div class="stat-value text-2xl">{newThisYear.toLocaleString()}</div></div>
          <div class="stat py-3"><div class="stat-title text-base-content/65">改正</div><div class="stat-value text-2xl">{m.counts.amendments.toLocaleString()}</div><div class="stat-desc text-base-content/65">データ更新：{jpDate(jstDate(m.generatedAt))}</div></div>
        </div>
      </section>
    </aside>
  </div>
</Base>

---
import Base from "../../layouts/Base.astro";
import {
  amendmentUrl,
  dataDate,
  jpDate,
  KIND_LABELS,
  law as loadLaw,
  lawsById,
  lawUrl,
  pageLaws,
  repealOf,
  STATUS_LABELS,
  TYPE_ORDER,
  typeLabel,
} from "../../lib/data.ts";
import { renderLawFile, renderInline } from "../../lib/lawtext.ts";
import { DATA_BASE, SITE_NAME, SOURCE_REPO } from "../../lib/site.ts";
import { DISCLAIMER_NOTE_HTML } from "../../lib/disclaimer.ts";
import { feedFile, feedIcon, feedUrl } from "../../lib/feeds.ts";
import { shareToolsHtml } from "../../lib/share.ts";
import { isStaged } from "../../lib/new-laws.ts";
import { lastTextBeforeRepeal, REPEAL_WAY_LABELS } from "../../lib/repealed-laws.ts";
import { jsonLdText, legislation } from "../../lib/seo.ts";
import { amendmentsInForce, isUnamended, listTitle, scanLaws } from "../../lib/stats.ts";
import { lawSummary, topCitations } from "../../lib/law-summary.ts";
import { termIndex, termUrl } from "../../lib/term-index.ts";
import { badgeClass } from "../../lib/badges.ts";
import { amendingLawNum } from "../../lib/law-num.ts";
import { billHeadline, billName, billsFile, billSteps, BILLS_LICENSE_URL, BILLS_SOURCE_CREDIT, BILLS_SOURCE_NAME, BILLS_SOURCE_URL, pendingBillsOf } from "../../lib/bills.ts";
import PageHeader from "../../components/PageHeader.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import BillSteps from "../../components/BillSteps.astro";

export function getStaticPaths() {
  return pageLaws().map((l) => ({ params: { id: l.id } }));
}

const { id } = Astro.params;
const law = loadLaw(id);
const rendered = law.status === "repealed" ? null : renderLawFile(law.path);
const source = typeof law.frontmatter.source === "string" ? law.frontmatter.source : null;
const revisions = [...law.revisions].reverse(); // newest first
// The latest change in force by another law: a later part of the law itself coming into force
// (段階施行) is not an amendment.
const latest = law.revisions.filter((r) => r.branch === "main" && !isStaged(r.kind, law.id, r.amendmentLawId)).at(-1);
const enacted = law.revisions.find((r) => r.kind === "enacted");
const repeal = law.status === "repealed" ? repealOf(law.id) : undefined;
const beforeRepeal = law.status === "repealed" ? lastTextBeforeRepeal(law.revisions) : null;
const beforeRepealUrl = beforeRepeal ? `/versions/?law=${law.id}&at=${encodeURIComponent(beforeRepeal)}` : null;
const anchor = `#law-${law.id}`;
// Never amended since it was made, according to e-Gov: links to the list of such laws.
const unamended = law.status === "in_force" && isUnamended(law.frontmatter);
// Amendments in force, counted as on the stats pages: not the enactment or 段階施行, but a first revision recorded
// from an amendment (収録開始) is one.
const amendments = amendmentsInForce(law).length;
const named = `${law.title}（${law.num}${law.abbrev ? `、略称：${law.abbrev}` : ""}）`;
const pageTitle = law.status === "repealed" ? `${law.title}（廃止）の改正履歴` : `${law.title}の条文と改正履歴`;
const description =
  law.status === "repealed"
    ? `${named}は${repeal?.enforced ? `${jpDate(repeal.enforced)}に` : ""}廃止された法令です。廃止直前の条文と、廃止までの改正の履歴・新旧対照を見られます。`
    : law.status === "upcoming_only"
      ? `${named}は公布済みで、まだ施行されていない法令です。施行後の条文を見られます。`
      : `${named}の現行の条文と、${amendments > 0 ? `改正 ${amendments} 件の履歴・新旧対照${latest?.kind === "amended" && latest.enforced ? `（最終改正：${jpDate(latest.enforced)}施行）` : ""}` : "改正の履歴"}${law.upcomingCount > 0 ? `。未施行の改正 ${law.upcomingCount} 件も見られます` : ""}。`;
// The law and the laws most often amended together with it.
// What a copied citation says the text is.
// The date is that of the data, not of the build: a build can reuse data extracted days before.
const citeAsOf =
  law.status === "upcoming_only"
    ? "公布済み・未施行の法令の条文"
    : law.status === "repealed"
      ? "廃止された法令の、廃止直前の条文"
      : `${jpDate(dataDate())}更新のデータによる現行条文`;
// The calendar of the days the law's amendments come into force (scripts/feeds.ts); a repealed law
// gets none.
const calendarUrl = law.status === "repealed" ? null : feedUrl(DATA_BASE, feedFile.law(law.id, "ics"));
const rssUrl = law.status === "repealed" ? null : feedUrl(DATA_BASE, feedFile.law(law.id, "xml"));
// The terms this law defines that have a page on /terms/, the most widely defined first.
const definedTerms = law.status === "in_force" ? (termIndex().byLaw.get(law.id) ?? []) : [];
const TERMS_SHOWN = 20;
// Bills in the Diet that would amend the law (src/lib/bills.ts), shown above its history.
const bills = law.status === "repealed" ? [] : pendingBillsOf(law.id);
const billsUpdated = billsFile()?.updated ?? null;
// Step dates without the year when it is the year of the line above them.
const timelineLength = bills.length + revisions.length;
// The laws in force that cite this law and that it cites (scanLaws), the constitution and Acts first. Only a few are
// listed: 民法 is cited by more than a thousand laws.
const CITATIONS_SHOWN = 10;
const scan = law.status === "in_force" ? scanLaws() : null;
const citedByIds = scan?.citedBy.get(law.id) ?? [];
const citesIds = scan?.cites.get(law.id) ?? [];
const citedCount = (lawId: string) => scan?.citedBy.get(lawId)?.length ?? 0;
const citedByTop = topCitations(citedByIds, lawsById(), citedCount, TYPE_ORDER, CITATIONS_SHOWN);
const citesTop = topCitations(citesIds, lawsById(), citedCount, TYPE_ORDER, CITATIONS_SHOWN);
// A summary of the facts above and on the rest of the page, in sentences (src/lib/law-summary.ts).
const summary =
  law.status === "in_force"
    ? lawSummary({
        name: listTitle(law.title, law.num),
        num: law.num,
        type: typeLabel(law.dir),
        enforced: enacted?.branch === "main" && enacted.enforced ? jpDate(enacted.enforced) : null,
        amendments,
        latest:
          latest?.kind === "amended" && latest.enforced
            ? { enforced: jpDate(latest.enforced), title: latest.amendmentTitle, href: amendmentUrl(latest.amendment) + anchor }
            : null,
        unamended,
        upcoming: law.upcomingCount,
        bills: bills.length,
        citedBy: citedByIds.length,
        cites: citesIds.length,
        terms: definedTerms.length,
      })
    : [];
const graphUrl = `/graph/?laws=${[law.id, ...law.related.slice(0, 3).map((r) => r.id)].join(",")}`;
const legislationLd = jsonLdText(
  legislation({
    url: new URL(`/laws/${law.id}/`, Astro.site).href,
    title: law.title,
    num: law.num,
    abbrev: law.abbrev,
    typeLabel: typeLabel(law.dir),
    status: law.status,
    lastAmended: latest?.enforced ?? null,
    source,
  }),
);
---
<Base title={pageTitle} description={description} feed={rssUrl ? { title: `${law.title}の改正（${SITE_NAME}）`, href: rssUrl } : undefined}>
  <PageHeader
    title={law.title}
    crumbs={[
      { href: "/browse/", label: "法令一覧" },
      { href: `/browse/type/${law.dir}/`, label: typeLabel(law.dir) },
      ...(law.category ? [{ href: `/browse/category/${law.category}/`, label: law.category }] : []),
    ]}
  >
    {law.status !== "in_force" && <StatusBadge slot="badge" kind={law.status === "repealed" ? "repealed" : "upcoming"} label={STATUS_LABELS[law.status]} />}
    {bills.length > 0 && <Fragment slot="badge">{" "}<a class={`${badgeClass("pending")} ml-0.5 hover:bg-base-200`} href="#bills">改正案を審議中</a></Fragment>}
    {unamended && <Fragment slot="badge">{" "}<a class={`${badgeClass("unamended")} ml-0.5 hover:bg-base-200`} href="/stats/unamended/">制定以来改正なし</a></Fragment>}
    <div class="flex flex-wrap gap-x-4 gap-y-1">
      <span data-law-num>{law.num}</span>
      {law.abbrev && <span>略称：{law.abbrev}</span>}
      {enacted && <span>制定：{enacted.enforced ? `${jpDate(enacted.enforced)} 施行` : "施行日未定"}{enacted.branch === "upcoming" && "（予定）"}</span>}
      {latest && latest.kind === "amended" && <span>最終改正：{jpDate(latest.enforced)} 施行（{amendingLawNum(latest.amendmentLawNum)}）</span>}
      {repeal && <span>廃止：{repeal.enforced ? `${jpDate(repeal.enforced)} 施行` : "施行日未定"}（{amendingLawNum(repeal.amendmentLawNum)}）</span>}
    </div>
  </PageHeader>
  <script is:inline type="application/ld+json" set:html={legislationLd} />
  <div class="-mt-2 mb-4 flex flex-wrap gap-2 print:hidden" data-share-title={law.title}>
    {beforeRepealUrl && <a class="btn btn-sm btn-primary" href={beforeRepealUrl}>廃止直前の条文</a>}
    {revisions.length > 0 && <a class:list={["btn btn-sm btn-primary", { "btn-soft": beforeRepealUrl }]} href={`/versions/?law=${law.id}`}>過去・将来の条文と比較</a>}
    <a class="btn btn-soft btn-sm btn-primary" href={graphUrl}>改正のグラフ</a>
    {source && <a class="btn btn-soft btn-sm btn-primary" href={source}>e-Gov 法令検索</a>}
    <a class="btn btn-soft btn-sm btn-primary" href={`${SOURCE_REPO}/commits/main/${law.path}`}>Git の履歴</a>
    {calendarUrl && rssUrl && (
      <details class="dropdown" data-menu>
        <summary class="btn btn-soft btn-sm btn-primary">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>カレンダー・RSS
        </summary>
        <div class="dropdown-content z-40 mt-1 w-72 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg">
          <p class="px-3 pt-1 pb-2 text-xs text-base-content/70">この法令の改正を、カレンダーや RSS リーダーで追えます。URL で登録すると、新しく公布された改正も毎日反映されます。</p>
          <ul class="menu w-full p-0">
            <li class="menu-title px-3 pt-1 pb-0 text-xs text-base-content/65">施行日のカレンダー（Google カレンダー・Outlook など）</li>
            <li><button type="button" class="gap-3 py-2" data-copy={calendarUrl} data-copy-done="カレンダーの URL をコピーしました"><Fragment set:html={feedIcon("calendar")} />カレンダーの URL をコピー</button></li>
            <li><a class="gap-3 py-2" href={calendarUrl}><Fragment set:html={feedIcon("file")} />.ics ファイルを開く</a></li>
            <li class="menu-title px-3 pt-2 pb-0 text-xs text-base-content/65">公布・施行のお知らせ（RSS）</li>
            <li><button type="button" class="gap-3 py-2" data-copy={rssUrl} data-copy-done="RSS の URL をコピーしました"><Fragment set:html={feedIcon("rss")} />RSS の URL をコピー</button></li>
            <li class="mt-1 border-t border-base-300 pt-1"><a class="gap-3 py-2" href="/upcoming/#calendar"><Fragment set:html={feedIcon("help")} />登録のしかた</a></li>
          </ul>
        </div>
      </details>
    )}
    <Fragment set:html={shareToolsHtml("sm:ml-auto", "sm:dropdown-end")} />
  </div>
  <Fragment set:html={DISCLAIMER_NOTE_HTML} />
  {summary.length > 0 && <p class="mb-4 text-sm leading-relaxed" data-law-summary>{summary.map((p) => (p.href ? <a class="link link-primary" href={p.href}>{p.text}</a> : p.text))}</p>}
  {rendered && <p class="-mt-2 mb-4 text-xs text-base-content/65 print:hidden">条の見出しを押すと、その条へのリンクや引用文をコピーできます。</p>}

  <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_340px] print:block">
    {/* The history comes before the text in the HTML, so that search engines see it on long laws
         (Googlebot reads the first 2 MB of a page); it is still shown after the text on narrow
         screens and to the right on wide ones. */}
    <aside class="order-last flex flex-col gap-4 text-sm print:hidden lg:sticky lg:order-none lg:col-start-2 lg:row-start-1 lg:top-[4.5rem] lg:max-h-[calc(100vh-5.5rem)] lg:overflow-auto">
      <section class="card card-border bg-base-100">
        <div class="card-body p-4">
          <h2 class="card-title text-base">改正履歴（{revisions.length} 件）</h2>
          <ul class="timeline timeline-vertical timeline-compact timeline-snap-icon [&>li]:[--timeline-col-start:0]">
            {bills.map((b, i) => {
              const head = billHeadline(b);
              const year = head.date?.slice(0, 4);
              const steps = billSteps(b);
              return (
                <li id={i === 0 ? "bills" : undefined} class="scroll-mt-20">
                  {i > 0 && <hr />}
                  <div class="timeline-middle">
                    <span class="mt-1.5 block h-2.5 w-2.5 rounded-full border-2 border-dashed border-secondary bg-base-100"></span>
                  </div>
                  <div class:list={["timeline-end ml-1 min-w-0", { "mb-4": i < timelineLength - 1 }]}>
                    <div class="font-bold">
                      {head.date ? `${jpDate(head.date)} ` : ""}{head.text}
                      <StatusBadge kind="pending" label="審議中" />
                    </div>
                    <div>
                      {b.honbunUrl ? <a class="link link-primary" href={b.honbunUrl} rel="noopener">{b.title}</a> : b.title}
                      <span class="text-xs text-base-content/65">（{billName(b)}{b.kind !== "閣法" && b.submitter ? `、提出：${b.submitter}` : ""}）</span>
                    </div>
                    <BillSteps steps={steps} year={year} />
                    {b.keikaUrl && (
                      <div class="mt-0.5 text-xs"><a class="link link-hover link-primary inline-block py-1" href={b.keikaUrl} rel="noopener">審議経過（衆議院）</a></div>
                    )}
                    {i === bills.length - 1 && (
                      <p class="mt-1 text-xs text-base-content/65">成立前の法律案です。修正されたり、成立しなかったりすることがあります。{billsUpdated && `${jpDate(billsUpdated)}時点。`}出典：<a class="link" href={BILLS_SOURCE_URL} rel="noopener">{BILLS_SOURCE_NAME}</a>（{BILLS_SOURCE_CREDIT}、<a class="link" href={BILLS_LICENSE_URL} rel="noopener">MIT ライセンス</a>）。<a class="link" href="/bills/">国会で審議中の法律案をすべて見る</a></p>
                    )}
                  </div>
                  {i < timelineLength - 1 && <hr />}
                </li>
              );
            })}
            {revisions.map((r, i) => (
              <li>
                {i + bills.length > 0 && <hr />}
                <div class="timeline-middle">
                  <span class:list={["mt-1.5 block h-2.5 w-2.5 rounded-full border-2", r.branch === "upcoming" ? "border-dashed border-primary bg-base-100" : "border-primary bg-primary"]}></span>
                </div>
                <div class:list={["timeline-end ml-1 min-w-0", { "mb-4": i < revisions.length - 1 }]}>
                  <div class="font-bold">
                    {r.enforced ? jpDate(r.enforced) : "施行日未定"}
                    {r.branch === "upcoming" ? <StatusBadge kind="upcoming" label="施行予定" /> : isStaged(r.kind, law.id, r.amendmentLawId) ? <StatusBadge kind="staged" label="段階施行" /> : <StatusBadge kind={r.kind} label={KIND_LABELS[r.kind]} />}
                  </div>
                  <div>
                    <a class="link link-primary" href={amendmentUrl(r.amendment) + anchor}>{r.amendmentTitle}</a>
                    <span class="text-xs text-base-content/65">（{amendingLawNum(r.amendmentLawNum)}）</span>
                  </div>
                  {r.titleChange && <div class="text-xs text-base-content/65">題名を「{r.titleChange.from}」から変更</div>}
                  {r.changedCount > 0 && (
                    <div class="text-xs text-base-content/65">
                      {r.changed.slice(0, 6).map((c, i) => <>{i > 0 && "・"}<span set:html={renderInline(c.heading)} /></>)}
                      {r.changedCount > 6 && <>ほか {r.changedCount - 6} 件</>}
                    </div>
                  )}
                  <div class="mt-0.5 flex flex-wrap gap-x-3 text-xs">
                    {r.kind === "amended" && <span class="tabular-nums"><span class="text-add">+{r.additions}</span> <span class="text-del">−{r.deletions}</span></span>}
                    {r.kind !== "repealed" && <a class="link link-hover link-primary inline-block py-1" href={`/versions/?law=${law.id}&at=${r.amendment}`}>この時点の条文</a>}
                  </div>
                </div>
                {i < revisions.length - 1 && <hr />}
              </li>
            ))}
          </ul>
        </div>
      </section>

      {rendered && rendered.toc.length > 0 && (
        <details class="collapse-arrow collapse border border-base-300 bg-base-100" open={rendered.toc.length <= 60}>
          <summary class="collapse-title font-bold">目次<span class="ml-1 font-normal text-base-content/65">（条文 {rendered.articleCount.toLocaleString()} 条）</span></summary>
          <div class="collapse-content px-2">
            <ul class="menu menu-sm w-full p-0">
              {rendered.toc.map((t) => (
                <li class={["", "", "", "pl-4", "pl-8", "pl-12", "pl-12"][t.level] ?? ""}><a href={`#${encodeURIComponent(t.id)}`} set:html={t.html} /></li>
              ))}
            </ul>
          </div>
        </details>
      )}
      {definedTerms.length > 0 && (
        <section id="terms" class="card card-border scroll-mt-20 bg-base-100">
          <div class="card-body gap-2 p-4">
            <h2 class="card-title text-base">この法令が定義している用語</h2>
            <p class="text-xs text-base-content/65">ほかの法令での定義と比べられます。</p>
            <ul class="flex flex-wrap gap-x-3 gap-y-1.5">
              {definedTerms.slice(0, TERMS_SHOWN).map((t) => <li><a class="link link-primary" href={termUrl(t)}>{t}</a></li>)}
            </ul>
            {definedTerms.length > TERMS_SHOWN && (
              <details>
                <summary class="cursor-pointer text-primary">ほか {definedTerms.length - TERMS_SHOWN} 語</summary>
                <ul class="mt-1.5 flex flex-wrap gap-x-3 gap-y-1.5">
                  {definedTerms.slice(TERMS_SHOWN).map((t) => <li><a class="link link-primary" href={termUrl(t)}>{t}</a></li>)}
                </ul>
              </details>
            )}
          </div>
        </section>
      )}
      {(citedByTop.length > 0 || citesTop.length > 0) && (
        <section class="card card-border bg-base-100">
          <div class="card-body gap-3 p-4">
            <h2 class="card-title text-base">引用関係</h2>
            {[
              { id: "cited-by", heading: "この法令を引用している法令", count: citedByIds.length, top: citedByTop },
              { id: "cites", heading: "この法令が引用している法令", count: citesIds.length, top: citesTop },
            ].filter((c) => c.top.length > 0).map((c) => (
              <div id={c.id} class="scroll-mt-20">
                <h3 class="font-bold">{c.heading}<span class="ml-1 font-normal text-base-content/65">（{c.count.toLocaleString()} 件）</span></h3>
                <ul class="mt-1 flex flex-col gap-1.5">
                  {c.top.map((l) => <li><a class="link link-primary" href={lawUrl(l.id)}>{listTitle(l.title, l.num)}</a><span class="ml-1 text-xs text-base-content/65">{typeLabel(l.dir)}</span></li>)}
                </ul>
                {c.count > c.top.length && <p class="mt-1 text-xs text-base-content/65">憲法・法律から順に、よく引用されている {c.top.length} 件を表示しています。</p>}
              </div>
            ))}
            <p class="text-xs"><a class="link" href="/stats/cited/">法令の被引用数ランキング</a></p>
          </div>
        </section>
      )}
    </aside>
    <article class="law-text min-w-0 lg:col-start-1 lg:row-start-1" data-law-text data-cite-law={law.title} data-cite-num={law.num} data-cite-asof={citeAsOf}>
      {rendered ? (
        <Fragment set:html={rendered.html} />
      ) : law.status === "repealed" ? (
        <div class="card card-border bg-base-100">
          <div class="card-body gap-2 p-5">
            <h2 class="card-title flex-wrap text-base">
              {repeal?.enforced ? `${jpDate(repeal.enforced)}に廃止されました` : "この法令は廃止されています"}
              {repeal && <span class="badge badge-ghost badge-sm whitespace-nowrap font-normal">{REPEAL_WAY_LABELS[repeal.way]}</span>}
            </h2>
            {repeal && (
              <dl class="grid gap-x-4 gap-y-1 text-sm sm:grid-cols-[auto_minmax(0,1fr)]">
                {repeal.newLaw ? (
                  <>
                    <dt class="text-base-content/70">新しい法令</dt>
                    <dd><a class="link link-primary" href={`/laws/${repeal.newLaw.id}/`}>{repeal.newLaw.title}</a><span class="text-xs text-base-content/65">（{amendingLawNum(repeal.amendmentLawNum)}）</span>の施行により廃止・<a class="link" href={`${amendmentUrl(repeal.amendment)}${anchor}`}>施行時の変更</a></dd>
                  </>
                ) : (
                  <>
                    <dt class="text-base-content/70">廃止した法令</dt>
                    <dd><a class="link link-primary" href={`${amendmentUrl(repeal.amendment)}${anchor}`}>{repeal.amendmentTitle}</a><span class="text-xs text-base-content/65">（{amendingLawNum(repeal.amendmentLawNum)}）</span></dd>
                  </>
                )}
                {repeal.alsoRepeals > 0 && (
                  <>
                    <dt class="text-base-content/70">同時に廃止</dt>
                    <dd>ほか {repeal.alsoRepeals} 法令（<a class="link" href={amendmentUrl(repeal.amendment)}>施行時の変更</a>）</dd>
                  </>
                )}
              </dl>
            )}
            <p class="text-sm text-base-content/70">
              {beforeRepealUrl ? <>廃止される前の条文は<a class="link link-primary" href={beforeRepealUrl}>廃止直前の条文</a>で見られます。</> : "houritsu には廃止される前の条文がありません。"}
              廃止までの改正履歴を<span class="lg:hidden">下</span><span class="hidden lg:inline">右</span>に表示しています。
            </p>
            <p class="text-xs"><a class="link" href="/repealed/">廃止された法令の一覧</a></p>
          </div>
        </div>
      ) : (
        <p class="text-base-content/70">この法令はまだ施行されていません。施行予定の改正を右に表示しています。</p>
      )}
    </article>

  </div>
</Base>

---
import Base from "../../layouts/Base.astro";
import { dataVersion } from "../../lib/data.ts";
import { DATA_BASE } from "../../lib/site.ts";
---
<Base
  title="改正"
  description="1つの改正で変わった条を、改正後と改正前を並べた新旧対照で見られます。"
  nav="timeline"
  canonical={false}
>
  <div id="amendment" data-base={DATA_BASE} data-v={dataVersion()}>
    <p class="loading">読み込み中…</p>
  </div>
  <noscript>改正の内容を表示するには JavaScript を有効にしてください。</noscript>
  <script>
    import { renderAmendmentPage } from "../../scripts/amendment.ts";
    void renderAmendmentPage(document.getElementById("amendment")!);
  </script>
</Base>

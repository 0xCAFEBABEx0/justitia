---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import PreviewAmendment from "../components/PreviewAmendment.astro";
import { PREVIEW } from "../lib/site.ts";
---
{PREVIEW ? (
  <Base title="ページが見つかりません" canonical={false}>
    <div id="not-found">
      <PageHeader title="ページが見つかりません" />
      <p>お探しのページはありませんでした。法令は<a class="link link-primary" href="/browse/">法令一覧</a>や、上の検索欄から探せます。</p>
      <p class="mt-3 text-base-content/65" data-preview-note hidden>プレビューでは、本番のデータにまだない改正は表示できません。</p>
    </div>
    <PreviewAmendment />
  </Base>
) : (
  <Base title="ページが見つかりません" narrow canonical={false}>
    <PageHeader title="ページが見つかりません" />
    <p>お探しのページはありませんでした。法令は<a class="link link-primary" href="/browse/">法令一覧</a>や、上の検索欄から探せます。</p>
  </Base>
)}

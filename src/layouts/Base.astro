---
import "@fontsource/noto-sans-jp/400.css";
import "@fontsource/noto-sans-jp/700.css";
import "../styles/global.css";
import { SITE_NAME, SITE_TAGLINE, SOURCE_REPO } from "../lib/site.ts";

interface Props {
  title?: string;
  description?: string;
  nav?: "laws" | "timeline" | "graph" | "search" | "about";
  narrow?: boolean;
  /**
   * Whether this URL (without its query string) is the page's address. False for pages whose
   * content comes from the query string (/amendment/?k=..., /versions/?law=...): a canonical
   * link there would make every amendment look like the same page.
   */
  canonical?: boolean;
}
const { title, description, nav, narrow = false, canonical = true } = Astro.props;
const NAV = [
  { key: "laws", href: "/browse/", label: "法令一覧" },
  { key: "timeline", href: "/timeline/", label: "改正の年表" },
  { key: "graph", href: "/graph/", label: "改正のグラフ" },
  { key: "search", href: "/search/", label: "全文検索" },
  { key: "about", href: "/about/", label: "このサイトについて" },
] as const;
const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME} — ${SITE_TAGLINE}`;
const desc = description ?? "日本の法令の条文と、いつ・どこが・どう改正されたかを、改正ごとの新旧対照で見られるサイトです。";
const url = canonical ? new URL(Astro.url.pathname, Astro.site).href : null;
// One image for every page (a per-law image would add about 9,000 files to the site).
const ogImage = new URL("/og-image.png", Astro.site).href;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {url && <link rel="canonical" href={url} />}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1d20" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={desc} />
    {url && <meta property="og:url" content={url} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME}：${SITE_TAGLINE}`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="drawer drawer-end">
      <input id="site-menu" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content flex min-h-screen flex-col">
        <header class="navbar sticky top-0 z-30 min-h-14 gap-2 border-b border-base-300 bg-base-100 px-4 py-0">
          <div class="mx-auto flex w-full max-w-[1180px] items-center gap-2">
            <a class="mr-2 shrink-0 text-lg font-bold tracking-wide" href="/">Anisotro<span class="text-primary">pics</span></a>
            <nav class="hidden lg:block" aria-label="サイト">
              <ul class="menu menu-horizontal menu-sm gap-1 px-0">
                {NAV.map((n) => (
                  <li><a class="aria-[current=page]:bg-primary/10 aria-[current=page]:font-bold aria-[current=page]:text-primary" href={n.href} aria-current={nav === n.key ? "page" : undefined}>{n.label}</a></li>
                ))}
              </ul>
            </nav>
            <div class="relative ml-auto w-full max-w-64 min-w-0" data-search>
              <label class="input input-sm w-full">
                <svg class="h-4 w-4 opacity-50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                <input type="search" placeholder="法令名で検索" aria-label="法令名で検索" autocomplete="off" />
              </label>
            </div>
            <label for="site-menu" class="btn btn-square btn-ghost btn-sm lg:hidden" aria-label="メニューを開く">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
            </label>
          </div>
        </header>
        <main class="grow py-6 pb-16">
          <div class:list={["mx-auto px-4", narrow ? "max-w-[860px]" : "max-w-[1180px]"]}>
            <slot />
          </div>
        </main>
        <footer class="border-t border-base-300 bg-base-100 py-6 text-sm text-base-content/70">
          <div class="mx-auto max-w-[1180px] px-4">
            条文と改正履歴は <a class="link" href={SOURCE_REPO}>houritsu</a>（e-Gov 法令データを Git の履歴にしたもの）から生成しています。
            正式な法令の内容は <a class="link" href="https://laws.e-gov.go.jp/">e-Gov 法令検索</a> で確認してください。
          </div>
        </footer>
      </div>
      <div class="drawer-side z-40">
        <label for="site-menu" aria-label="メニューを閉じる" class="drawer-overlay"></label>
        <nav class="min-h-full w-72 bg-base-100 p-4" aria-label="サイト">
          <a class="mb-2 block px-3 text-lg font-bold" href="/">Anisotro<span class="text-primary">pics</span></a>
          <ul class="menu w-full">
            {NAV.map((n) => (
              <li><a class="aria-[current=page]:bg-primary/10 aria-[current=page]:font-bold aria-[current=page]:text-primary" href={n.href} aria-current={nav === n.key ? "page" : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
    <script>
      import { initSearch } from "../scripts/search.ts";
      document.querySelectorAll<HTMLElement>("[data-search]").forEach((el) => initSearch(el));
    </script>
  </body>
</html>

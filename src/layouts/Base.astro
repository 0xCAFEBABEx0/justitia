---
import "@fontsource/noto-sans-jp/400.css";
import "@fontsource/noto-sans-jp/700.css";
import "../styles/global.css";
import { SITE_NAME, SITE_TAGLINE, SOURCE_REPO } from "../lib/site.ts";
import { DISCLAIMER_URL, EGOV_URL } from "../lib/disclaimer.ts";

interface Props {
  title?: string;
  description?: string;
  nav?: "laws" | "new" | "timeline" | "graph" | "search" | "about";
  narrow?: boolean;
  /**
   * Whether this URL (without its query string) is the page's address. False for pages whose
   * content comes from the query string (/amendment/?k=..., /versions/?law=...): a canonical
   * link there would make every amendment look like the same page.
   */
  canonical?: boolean;
}
const { title, description, nav, narrow = false, canonical = true } = Astro.props;
const NAV = [
  { key: "laws", href: "/browse/", label: "法令一覧" },
  { key: "new", href: "/new/", label: "新しい法令" },
  { key: "timeline", href: "/timeline/", label: "改正の年表" },
  { key: "graph", href: "/graph/", label: "改正のグラフ" },
  { key: "search", href: "/search/", label: "全文検索" },
  { key: "about", href: "/about/", label: "このサイトについて" },
] as const;
const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME} — ${SITE_TAGLINE}`;
const desc = description ?? "日本の法令の条文と、いつ・どこが・どう改正されたかを、改正ごとの新旧対照で見られるサイトです。";
const url = canonical ? new URL(Astro.url.pathname, Astro.site).href : null;
// One image for every page (a per-law image would add about 9,000 files to the site).
const ogImage = new URL("/og-image.png", Astro.site).href;
---
<!doctype html>
<html lang="ja">
  <head>
    <script is:inline>
      // The theme picked with the header switch (src/scripts/theme.ts), set before the page is drawn.
      // Without one, daisyUI follows the OS setting.
      try {
        const t = localStorage.getItem("justitia:theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {url && <link rel="canonical" href={url} />}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1d20" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={desc} />
    {url && <meta property="og:url" content={url} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME}：${SITE_TAGLINE}`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="drawer drawer-end">
      <input id="site-menu" type="checkbox" class="drawer-toggle" aria-label="メニュー" />
      <div class="drawer-content flex min-h-screen flex-col">
        <header class="navbar sticky top-0 z-30 min-h-14 gap-2 border-b border-base-300 bg-base-100 px-4 py-0">
          <div class="mx-auto flex w-full max-w-[1180px] items-center gap-2">
            <a class="mr-2 shrink-0 text-lg font-bold tracking-wide" href="/">Anisotro<span class="text-primary">pics</span></a>
            <nav class="hidden lg:block" aria-label="サイト">
              <ul class="menu menu-horizontal menu-sm gap-1 px-0">
                {NAV.map((n) => (
                  <li><a class="aria-[current=page]:bg-primary/10 aria-[current=page]:font-bold aria-[current=page]:text-primary" href={n.href} aria-current={nav === n.key ? "page" : undefined}>{n.label}</a></li>
                ))}
              </ul>
            </nav>
            <div class="relative ml-auto w-full max-w-64 min-w-0" data-search>
              <label class="input input-sm w-full">
                <svg class="h-4 w-4 opacity-50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                <input type="search" placeholder="法令名で検索" aria-label="法令名で検索" autocomplete="off" />
              </label>
            </div>
            <label class="swap swap-rotate btn btn-square btn-ghost btn-sm" title="ライト／ダークの切り替え">
              <input type="checkbox" class="theme-controller" value="dark" aria-label="ダークモード" autocomplete="off" data-theme-switch />
              <svg class="swap-off h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z" /></svg>
              <svg class="swap-on h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z" /></svg>
            </label>
            <label for="site-menu" class="drawer-button btn btn-square btn-ghost btn-sm lg:hidden" title="メニュー">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
            </label>
          </div>
        </header>
        <main class="grow py-6 pb-16">
          <div class:list={["mx-auto px-4", narrow ? "max-w-[860px]" : "max-w-[1180px]"]}>
            <slot />
          </div>
        </main>
        <footer class="border-t border-base-300 bg-base-100 py-6 text-sm text-base-content/70">
          <div class="mx-auto max-w-[1180px] space-y-2 px-4">
            <p>
              条文と改正履歴は <a class="link" href={SOURCE_REPO}>houritsu</a>（e-Gov 法令データを Git の履歴にしたもの）からプログラムで自動的に生成しています。変換の誤りや不具合により、条文の表示が崩れたり、誤った新旧対照が表示されたりすることがあります。正式な法令の内容は <a class="link" href={EGOV_URL}>e-Gov 法令検索</a> で確認してください。
            </p>
            <p>
              本サイトは非公式のサイトで、内容の正確性を保証しません。本サイトの利用により生じた損害について、管理者は一切の責任を負いません。詳しくは<a class="link" href={DISCLAIMER_URL}>免責事項</a>をご覧ください。
            </p>
          </div>
        </footer>
      </div>
      <div class="drawer-side z-40">
        <label for="site-menu" class="drawer-overlay" aria-hidden="true"></label>
        <nav class="min-h-full w-72 bg-base-100 p-4" aria-label="サイト">
          <a class="mb-2 block px-3 text-lg font-bold" href="/">Anisotro<span class="text-primary">pics</span></a>
          <ul class="menu w-full">
            {NAV.map((n) => (
              <li><a class="aria-[current=page]:bg-primary/10 aria-[current=page]:font-bold aria-[current=page]:text-primary" href={n.href} aria-current={nav === n.key ? "page" : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
    <script>
      import { initSearch } from "../scripts/search.ts";
      import { initThemeSwitch } from "../scripts/theme.ts";
      document.querySelectorAll<HTMLInputElement>("[data-theme-switch]").forEach((el) => initThemeSwitch(el));
      document.querySelectorAll<HTMLElement>("[data-search]").forEach((el) => initSearch(el));
    </script>
  </body>
</html>

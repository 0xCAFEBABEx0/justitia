---
import { amendmentUrl, jpDate, KIND_LABELS, lawUrl, type AmendmentSummary } from "../lib/data.ts";
import StatusBadge from "./StatusBadge.astro";
import { amendmentLawIdOf, isStaged } from "../lib/new-laws.ts";
import { amendingLawNum } from "../lib/law-num.ts";

interface Props {
  items: AmendmentSummary[];
  groupByDate?: boolean;
  /** Draw the list without its own border and background (inside a card). */
  bare?: boolean;
  /** Level of the date headings: one below the heading the list sits under. */
  headingLevel?: 2 | 3;
  /** Extra attributes for each item (the upcoming page filters by them). */
  itemAttrs?: (a: AmendmentSummary) => Record<string, string>;
  /** Show how many days are left until each date heading, counted from this day (YYYY-MM-DD). */
  countdownFrom?: string;
}
const { items, groupByDate = true, bare = false, headingLevel = 3, itemAttrs, countdownFrom } = Astro.props;
const daysUntil = (date: string) => countdownFrom ? Math.round((Date.parse(date) - Date.parse(countdownFrom)) / 86_400_000) : null;
const DateHeading = `h${headingLevel}` as const;
// How the amending law relates to the laws it changes: it enacts one of them (a new law), or it is
// a later part of a new law coming into force (段階施行).
const role = (a: AmendmentSummary) => {
  const self = amendmentLawIdOf(a.key);
  return {
    enacts: a.laws.some((l) => l.kind === "enacted"),
    staged: a.laws.some((l) => isStaged(l.kind, l.id, self)),
    self,
  };
};
// Without date headings, the whole list is one group (one box, with lines between the items).
const groups: [string, AmendmentSummary[]][] = groupByDate ? [] : [["", items]];
for (const a of groupByDate ? items : []) {
  const d = a.enforced ?? "";
  const last = groups.at(-1);
  if (last && last[0] === d) last[1].push(a);
  else groups.push([d, [a]]);
}
---
{groups.map(([date, list]) => (
  <section data-group>
    {groupByDate && (
      <DateHeading class="mt-5 mb-1.5 text-sm font-bold text-base-content/70">
        {date ? jpDate(date) : "施行日未定"}
        {date && daysUntil(date) !== null && <span class="ml-2 font-normal text-base-content/65">{daysUntil(date) === 0 ? "今日" : `あと ${daysUntil(date)} 日`}</span>}
      </DateHeading>
    )}
    <ul class:list={["list", { "rounded-box border border-base-300 bg-base-100": !bare }]}>
      {list.map((a) => (
        <li class:list={["list-row", bare ? "px-0 py-2.5" : "py-3"]} {...(itemAttrs?.(a) ?? {})}>
          <div class="list-col-grow">
            {!groupByDate && <div class="text-xs font-bold text-base-content/70">{jpDate(a.enforced)}</div>}
            <a class="link link-hover font-bold text-primary" href={amendmentUrl(a.key)}>{a.title}</a>
            {role(a).enacts && <StatusBadge kind="enacted" label="新規制定" />}
            {role(a).staged && <StatusBadge kind="staged" label="段階施行" />}
            {a.branch === "upcoming" && <StatusBadge kind="upcoming" label="施行予定" />}
            <div class="mt-1 text-xs text-base-content/65">
              {amendingLawNum(a.amendmentLawNum)}・
              {a.laws.slice(0, 4).map((l, i) => (
                <>{i > 0 && "、"}<a class="link link-hover" href={lawUrl(l.id)}>{l.title}</a>{l.kind !== "amended" ? `（${KIND_LABELS[l.kind]}）` : isStaged(l.kind, l.id, role(a).self) && "（段階施行）"}</>
              ))}
              {a.laws.length > 4 && <>ほか {a.laws.length - 4} 法令</>}
              {a.additions + a.deletions > 0 && <> <span class="text-add">+{a.additions}</span> <span class="text-del">−{a.deletions}</span></>}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>
))}

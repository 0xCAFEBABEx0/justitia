---
import { KANA_ROWS, OTHER_ROW, TYPE_LABELS, TYPE_ORDER } from "../lib/data.ts";

interface Props {
  mode: "kana" | "type" | "category" | "none";
  current?: string;
}
const { mode, current } = Astro.props;
const kanaRows = [...KANA_ROWS.map((r) => r.row), OTHER_ROW];
// daisyUI draws inactive tabs at 50% of the text color, too faint on base-200 for WCAG AA (4.5:1).
const tab = (active: boolean) => ["tab", active ? "tab-active" : "text-base-content/65 hover:text-base-content"];
---
<div class="mb-4 flex flex-col gap-2">
  <nav class="tabs tabs-box tabs-sm w-fit max-w-full flex-wrap border border-base-300" aria-label="五十音">
    {kanaRows.map((r) => {
      const active = mode === "kana" && current === r;
      return <a class:list={tab(active)} href={`/browse/kana/${r}/`} aria-current={active ? "page" : undefined}>{r}</a>;
    })}
  </nav>
  <nav class="tabs tabs-box tabs-sm w-fit max-w-full flex-wrap border border-base-300" aria-label="種別">
    {TYPE_ORDER.map((t) => {
      const active = mode === "type" && current === t;
      return <a class:list={tab(active)} href={`/browse/type/${t}/`} aria-current={active ? "page" : undefined}>{TYPE_LABELS[t]}</a>;
    })}
    <a class:list={tab(mode === "category")} href="/browse/#category" aria-current={mode === "category" ? "page" : undefined}>分野別</a>
  </nav>
</div>

---
import { jpDate, lawUrl, STATUS_LABELS, typeLabel, type LawSummary } from "../lib/data.ts";
import StatusBadge from "./StatusBadge.astro";

interface Props {
  laws: LawSummary[];
  showType?: boolean;
}
const { laws, showType = true } = Astro.props;
---
<ul class="list rounded-box border border-base-300 bg-base-100">
  {
    laws.map((l) => (
      <li class="list-row py-3">
        <div class="list-col-grow">
          <a class="link link-hover font-bold text-primary" href={lawUrl(l.id)}>{l.title}</a>
          {l.status !== "in_force" && <StatusBadge kind={l.status === "repealed" ? "repealed" : "upcoming"} label={STATUS_LABELS[l.status]} />}
          <div class="mt-0.5 text-xs text-base-content/65">
            {showType && <>{typeLabel(l.dir)}・</>}
            {l.num}
            {l.revisionCount > 1 && <>・改正履歴 {l.revisionCount - 1} 件（最終 {jpDate(l.lastAmended)}）</>}
            {l.upcomingCount > 0 && <>・未施行の改正 {l.upcomingCount} 件</>}
          </div>
        </div>
      </li>
    ))
  }
</ul>
